          }
        }
      }
    },
    "localPersistence.alternateDataProtectionKeyRetained.bannerMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rill found an additional local data protection key and retained both keys to avoid deleting data. Saved data remains available and changes continue to be saved. No action is required, and no saved data was reset or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rill 发现了另一把本地数据保护密钥。为避免删除数据，两把密钥均已保留；已保存的数据仍可使用，后续更改也会继续保存。无需执行任何操作，已有数据未被重置或删除。"
          }
        }
      }
    },
    "localPersistence.alternateDataProtectionKeyRetained.bannerTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage is protected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存储已受保护"
          }
        }
      }
    },
    "localPersistence.alternateDataProtectionKeyRetained.menuDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage remains active; both protected keys were kept for safety."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存储仍正常工作；为确保数据安全，两把受保护密钥均已保留。"
          }
        }
      }
    },
    "localPersistence.alternateDataProtectionKeyRetained.menuTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional protection key retained"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留另一把数据保护密钥"
          }
        }
      }
    },
    "localPersistence.keychainTemporarilyUnavailable.actionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Storage Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看存储设置"
          }
        }
      }
    },
    "localPersistence.keychainTemporarilyUnavailable.bannerMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rill could not access its local data protection key. This session's history, records and collections, settings, and other local changes will not be saved. Unlock your Mac, then quit and reopen Rill. Existing saved data was not reset or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rill 无法访问本地数据保护密钥。本次会话中的运行历史、记录与记录集、设置及其他本地更改不会保存。请解锁 Mac，然后退出并重新打开 Rill；已有数据未被重置或删除。"
          }
        }
      }
    },
    "localPersistence.keychainTemporarilyUnavailable.bannerTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your Mac to restore local storage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 Mac 以恢复本地存储"
