    "general.settingsCorpusRecordingArchiveClearConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all corpus recordings?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部语料录音吗？"
          }
        }
      }
    },
    "general.settingsCorpusRecordingArchiveClearConfirmationDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes every encrypted corpus recording. Run history and transcripts are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除全部加密的语料录音；运行历史和转写不会改变。"
          }
        }
      }
    },
    "general.settingsCorpusRecordingArchiveDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When enabled, every recording that reaches workflow processing is encrypted with the local Keychain key and kept until cleared. Nothing is uploaded automatically. Turning this off stops new saves but keeps the existing archive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后，每条进入工作流处理的录音都会使用本机 Keychain 密钥加密保存，直到手动清除；不会自动上传。关闭只会停止新增，不会删除已有归档。"
          }
        }
      }
    },
    "general.settingsFailedAudioRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep failed recordings for manual retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留失败录音以供手动重试"
          }
        }
      }
    },
    "general.settingsFailedAudioRecoveryClear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Failed Recordings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除失败录音"
          }
        }
      }
    },
    "general.settingsFailedAudioRecoveryClearConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all retained failed recordings?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部保留的失败录音吗？"
          }
        }
      }
    },
    "general.settingsFailedAudioRecoveryClearConfirmationDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes every encrypted recovery recording. Run history and completed transcripts are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除全部加密恢复录音；运行历史和已完成的转写不会改变。"
          }
        }
      }
    },
    "general.settingsFailedAudioRecoveryDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Eligible recordings are encrypted with the local Keychain key for up to 24 hours (3 items, 16 MB each, 32 MB total). Retry rechecks current privacy and provider settings, writes only to History, and never repeats output actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。符合条件的录音会使用本机 Keychain 密钥加密保存，最长 24 小时（最多 3 条、单条 16 MB、总计 32 MB）。重试会重新检查当前隐私与服务配置，只写入历史，不会重复执行输出动作。"
          }
        }
      }
    },
    "general.settingsLongRecordingMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle recording hotkey mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换式录音快捷键模式"
          }
        }
      }
    },
    "general.settingsLongRecordingModeDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press once to start and again to stop. The selected recording limit applies to built-in and manual voice runs."
