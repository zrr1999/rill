  "sourceLanguage": "en",
  "strings": {
    "AppModel.Events.A.copied.item.was.saved.in.All.Records.but.was.not.added": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copied item was saved in All Records but was not added to pending output. Select the record and use Add to in the Output buffers menu to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条复制内容已保存在全部记录，但未加入待输出容器。请选中该记录，在待输出容器菜单中选择“加入”重试。"
          }
        }
      }
    },
    "AppModel.Events.An.output.action.failed.Open.Diagnostics.for.a.safe.summary.then.retry": {
      "extractionState": "manual",
