{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>zrr1999/renovate-config"
  ],
  "commitMessagePrefix": "⬆️ deps-up: ",
  "prHeader": "## 动机\n\n更新依赖以获得受维护版本的修复。\n\n## 解决方案\n\n以下为自动生成的依赖变更；实际验证结果以本 PR 的检查为准。",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    }
  ]
}
